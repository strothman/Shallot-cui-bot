# ==============================================================================
# Shallot-CUI Discord Bot Configuration Template
# Copy this file to '.env' and fill in your values.
# ==============================================================================

# Discord Bot Token (Obtained from https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Bot Owner Discord Snowflake ID (Optional - grants owner access to server control commands)
BOT_OWNER_ID=0

# ==============================================================================
# ComfyUI Server Settings
# ==============================================================================

# ComfyUI REST & WebSocket Server Address
COMFYUI_ADDRESS=127.0.0.1:8188

# Default SDXL Checkpoint Model filename
COMFYUI_CHECKPOINT=waiIllustriousSDXL_v170.safetensors

# Default Negative Prompt for image generation
DEFAULT_NEGATIVE_PROMPT=low quality, blurry, bad hands, extra fingers, distorted hands, deformed anatomy, bad face, malformed eyes, extra limbs, duplicate subject, signature, text, watermark, logo, cropped, flat lighting, muddy colors, cluttered background

# Save Prefix in ComfyUI output directory
IMAGE_SAVE_PREFIX=Discord Bot/

# ComfyUI Batch File Path (used for /cui-start command)
COMFYUI_BATCH_PATH=C:\ComfyUI\run_nvidia_gpu.bat

# VRAM Caution Thresholds (prevents launch if external applications e.g. Tdarr consume VRAM)
VRAM_CAUTION_THRESHOLD_PERCENT=85.0
VRAM_MIN_FREE_GB=2.0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
